{
  "name": "boundary_call_in_recursion",
  "description": "A call in a recursive equation gives it effects: each step calls, in order.",
  "source": "libc -> <libc.so.6>{\n  puts -> {string:s, -> !?::i32}\n  abs -> {i32:n, -> !?::i32}\n  srand -> {u32:seed, -> !?::none}\n  pi -> {-> 3}\n}\nsay -> {u8:n -> ??  -> n ? {0 -> 0  -> libc.abs{n -> 1}! + say{n -> n - 1}!}}\nx -> say{n -> 3}!",
  "type": "ε<say{n -> 3}!>(x, x)",
  "productions": {
    "say": "?3 ? {0 -> 0  -> ε<abs{n -> 1}!>(x::i32, ε<say{n -> ?3 - 1}!>(y, x + y))}"
  },
