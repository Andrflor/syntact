// sum: Goose bench/cpp/sum.cpp (the C++ the harness compares Goose with), in plain
// Syntact. N values from xorshift64, each mod 1000, pushed to an array; then eight
// passes, total += x ^ p. Prints the length of the array and the total.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
// an array that captures its length in a hole
Array -> {
  T <- {}
  n <- 0..
  -> {...({T:} * n):}
}
// data.size(): the length the array captures
len -> {
  T <- {}
  n <- 0..
  Array{T <- T  n <- n}:xs -> {}
  -> n
}
// xorshift64, as bench/cpp/bench.h: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
// for (i = 0; i < N; i++) { r = xs_next(r); data.push_back(xs_mod(r, 1000)); }
build -> {
  u32:n -> ??
  u32:i -> 0
  u64:r -> 12345
  Array{T <- i32}:data -> {}
  -> i ? {
    >=n -> data
    -> {
      s -> xs{x -> r}!
      -> build{n -> n  i -> i + 1  r -> s  data -> {...data  s % 1000}}!
    }!
  }
}
// for (x : data) total += x ^ p;
scan -> {
  Array{T <- i32}:data -> {}
  i64:p -> 0
  i64:total -> 0
  -> data ? {
    {i32(x)  ...Array{T <- i32}:(rest)} -> scan{data -> rest  p -> p  total -> total + (x ^ p)}!
    -> total
  }
}
// for (p = 0; p < 8; p++) the scan, on one total
passes -> {
  Array{T <- i32}:data -> {}
  i64:p -> 0
  i64:total -> 0
  -> p ? {
    >=8 -> total
    -> passes{data -> data  p -> p + 1  total -> scan{data -> data  p -> p  total -> total}!}!
  }
}
-> {
  Array{T <- i32}:data -> build{n -> ??::u32}!
  a -> io.printf{format -> "%lld\n"  n -> len{xs -> data}!}!
  -> io.printf{format -> "%lld\n"  n -> passes{data -> data}!}!
}!
