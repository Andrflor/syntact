// sum (Goose bench/goose/sum.goose): N values from xorshift64, each mod 1000, then
// eight passes, total += x ^ p. Prints the length and the total.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
Array -> {T -> {}  -> {}  -> {T: ...Array{T}:}}
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
build -> {
  u32:n -> ??
  u64:r -> 12345
  Array{u16}:acc -> {}
  -> n ? {0 -> acc  -> build{n -> n - 1  r -> xs{x -> r}!  acc -> {...acc  xs{x -> r}! % 1000}}!}
}
scan -> {
  Array{u16}:data -> {}
  u8:p -> 0
  acc -> 0
  -> data ? {
    {u16(h) ...Array{u16}:(t)} -> scan{data -> t  p -> p  acc -> acc + (h ^ p)}!
    -> acc
  }
}
count -> {
  Array{u16}:data -> {}
  acc -> 0
  -> data ? {
    {u16(h) ...Array{u16}:(t)} -> count{data -> t  acc -> acc + 1}!
    -> acc
  }
}
passes -> {
  Array{u16}:data -> {}
  u8:p -> 0
  acc -> 0
  -> p ? {>=8 -> acc  -> passes{data -> data  p -> p + 1  acc -> acc + scan{data -> data  p -> p}!}!}
}
-> {
  data -> build{n -> ??::u32}!
  a -> io.printf{format -> "%lld\n"  n -> count{data -> data}!}!
  -> io.printf{format -> "%lld\n"  n -> passes{data -> data}!}!
}!
