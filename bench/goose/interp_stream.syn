// interp, streamed: the same checksum as interp.syn, without the tree. Each of the
// eight evaluations follows the recursion that would build the tree, drawing the
// same seeds again. This does NOT measure what the benchmark measures (building an
// expression tree and evaluating it eight times): interp.syn is that program.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
Array -> {
  T -> {}
  -> {}
  -> {T: ...Array{T}:}
}
// xorshift64, as bench/goose/rng.goose: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
M -> 1000003
eval -> {
  (0..30):depth -> ??
  u64:seed -> 12345
  (0..7):p -> 0
  -> {
    s -> xs{x -> seed}!
    k -> s % 8
    -> depth ? {
      0 -> (s % 1000 + p) % M
      -> k ? {
        0 -> (M - eval{depth -> depth - 1  seed -> s  p -> p}!) % M
        <5 -> (eval{depth -> depth - 1  seed -> s  p -> p}! + eval{depth -> depth - 1  seed -> xs{x -> s}!  p -> p}!) % M
        -> (eval{depth -> depth - 1  seed -> s  p -> p}! * eval{depth -> depth - 1  seed -> xs{x -> s}!  p -> p}!) % M
      }
    }
  }!
}
count -> {
  (0..30):depth -> ??
  u64:seed -> 12345
  -> {
    s -> xs{x -> seed}!
    -> depth ? {
      0 -> 1
      -> s % 8 ? {
        0 -> 1 + count{depth -> depth - 1  seed -> s}!
        -> 1 + count{depth -> depth - 1  seed -> s}! + count{depth -> depth - 1  seed -> xs{x -> s}!}!
      }
    }
  }!
}
-> {
  (0..30):depth -> ??
  a -> io.printf{format -> "%lld\n"  n -> count{depth -> depth}! % 4611686018427387904}!
  t -> eval{depth -> depth  p -> 0}! + eval{depth -> depth  p -> 1}! + eval{depth -> depth  p -> 2}! + eval{depth -> depth  p -> 3}! + eval{depth -> depth  p -> 4}! + eval{depth -> depth  p -> 5}! + eval{depth -> depth  p -> 6}! + eval{depth -> depth  p -> 7}!
  -> io.printf{format -> "%lld\n"  n -> t % M}!
}!
