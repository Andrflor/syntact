// graph: Goose bench/cpp/graph.cpp (the C++ the harness compares Goose with), in
// plain Syntact. nv vertices, 8 * nv edges u -> w drawn from xorshift64 and pushed
// to the adjacency list of u; then a breadth-first search from four sources (seed
// 999), the total of the distances it reaches. Prints nv + ne and the total.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
// an array that captures its length in a hole
Array -> {
  T <- {}
  n <- 0..
  -> {...({T:} * n):}
}
// xorshift64, as bench/cpp/bench.h: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
DEG -> 8
SOURCES -> 4
graph -> {
  // nv = BENCH_N; xs_mod(seed, nv) runs whatever the edges, so nv >= 1
  (1..2147483647):nv -> ??
  ne -> nv * DEG
  // a vertex, an int32_t below nv
  Vertex -> 0..(nv - 1)
  Edges -> Array{T <- Vertex}
  Adj -> Array{T <- Edges  n <- nv}
  Dist -> Array{T <- i32  n <- nv}
  // std::vector<std::vector<int32_t>> adj(nv): nv empty lists
  empties -> {
    i64:v -> 0
    Array{T <- Edges}:adj -> {}
    -> v ? {
      >=nv -> adj
      -> empties{v -> v + 1  adj -> {...adj  {}}}!
    }
  }
  // for (e = 0; e < ne; e++) { r = xs_next(r); adj[xs_mod(r, nv)].push_back(xs_mod(r >> 24, nv)); }
  build -> {
    i64:e -> 0
    u64:r -> 12345
    Adj:adj -> ??
    -> e ? {
      >=ne -> adj
      -> {
        s -> xs{x -> r}!
        u -> s % nv
        -> build{e -> e + 1  r -> s  adj -> adj{#u -> {...adj.#u  (s >> 24) % nv}}}!
      }!
    }
  }
  // std::vector<int32_t> dist(nv): nv zeros
  zeros -> {
    i64:v -> 0
    Array{T <- i32}:dist -> {}
    -> v ? {
      >=nv -> dist
      -> zeros{v -> v + 1  dist -> {...dist  0}}!
    }
  }
  // for (v = 0; v < nv; v++) dist[v] = -1;
  reset -> {
    Dist:dist -> ??
    i64:v -> 0
    -> v ? {
      >=nv -> dist
      -> reset{dist -> dist{#v -> -1}  v -> v + 1}!
    }
  }
  // for (w : adj[u]) if (dist[w] < 0) { dist[w] = d + 1; q.push_back(w); }
  visit -> {
    Edges:es -> {}
    i64:d -> 0
    Dist:dist -> ??
    Array{T <- Vertex}:q -> {}
    -> es ? {
      {Vertex(w)  ...Edges:(rest)} -> dist.#w ? {
        <0 -> visit{es -> rest  d -> d  dist -> dist{#w -> d + 1}  q -> {...q  w}}!
        -> visit{es -> rest  d -> d  dist -> dist  q -> q}!
      }
      -> {dist -> dist  q -> q}
    }
  }
  // for (qh = 0; qh < q.size(); qh++) { u = q[qh]; d = dist[u]; total += d; visit the edges of u }
  bfs -> {
    Adj:adj -> ??
    Dist:dist -> ??
    qn <- 0..
    Array{T <- Vertex  n <- qn}:q -> {}
    i64:qh -> 0
    i64:total -> 0
    -> qh ? {
      >=qn -> {dist -> dist  total -> total}
      -> {
        u -> q.#qh
        d -> dist.#u
        v -> visit{es -> adj.#u  d -> d  dist -> dist  q -> q}!
        -> bfs{adj -> adj  dist -> v.dist  q -> v.q  qh -> qh + 1  total -> total + d}!
      }!
    }
  }
  // for (s = 0; s < SOURCES; s++) { seed = xs_next(seed); srcv = xs_mod(seed, nv);
  //   reset dist; q.clear(); dist[srcv] = 0; q.push_back(srcv); the BFS }
  sources -> {
    Adj:adj -> ??
    Dist:dist -> ??
    i64:s -> 0
    u64:seed -> 999
    i64:total -> 0
    -> s ? {
      >=SOURCES -> total
      -> {
        sd -> xs{x -> seed}!
        srcv -> sd % nv
        b -> bfs{adj -> adj  dist -> reset{dist -> dist}!{#srcv -> 0}  q -> {srcv}  total -> total}!
        -> sources{adj -> adj  dist -> b.dist  s -> s + 1  seed -> sd  total -> b.total}!
      }!
    }
  }
  Adj:adj -> build{adj -> empties!}!
  total -> sources{adj -> adj  dist -> zeros!}!
  a -> io.printf{format -> "%lld\n"  n -> nv + ne}!
  -> io.printf{format -> "%lld\n"  n -> total}!
}
-> graph{nv -> ??::(1..2147483647)}!
