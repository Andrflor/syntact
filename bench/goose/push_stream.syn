// push, streamed: the same checksums as push.syn, without the items or the kept
// positions: the keys and the vals of every 64th item are summed as they are
// drawn. This does NOT measure what the benchmark measures (pushing N records and
// reading back through kept references): push.syn is that program.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
Array -> {
  T -> {}
  -> {}
  -> {T: ...Array{T}:}
}
// xorshift64, as bench/goose/rng.goose: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
keys -> {
  u32:n -> ??
  u64:r -> 12345
  acc -> 0
  -> n ? {0 -> acc  -> keys{n -> n - 1  r -> xs{x -> r}!  acc -> acc + xs{x -> r}! % 1000000}!}
}
// over the kept positions 64 * j, j from m - 1 down to 0; counted down, since a
// cover >=n, n unknown, does not narrow i below n (see the report)
vals -> {
  u32:m -> ??
  acc -> 0
  -> m ? {0 -> acc  -> vals{m -> m - 1  acc -> acc + 64 * (m - 1) % 97}!}
}
-> {
  u32:n -> ??
  a -> io.printf{format -> "%lld\n"  n -> n}!
  b -> io.printf{format -> "%lld\n"  n -> (n + 63) / 64}!
  c -> io.printf{format -> "%lld\n"  n -> keys{n -> n}! % 4611686018427387904}!
  -> io.printf{format -> "%lld\n"  n -> vals{m -> (n + 63) / 64}! % 4611686018427387904}!
}!
