// particles: Goose bench/cpp/particles.cpp (the C++ the harness compares Goose
// with, VARIANT 0: array of structs, the update per component), in plain Syntact.
// n particles {pos, vel} from xorshift64, 200 steps of vel.y += -0.0625,
// pos += vel and a bounce on pos.y < 0; then the total of (long long)(c * 16.0f)
// over the components of the positions. Prints n and the total.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
// an array that captures its length in a hole
Array -> {
  T <- {}
  n <- 0..
  -> {...({T:} * n):}
}
// xorshift64, as bench/cpp/bench.h: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
STEPS -> 200
F3 -> {f32:x  f32:y  f32:z}
P -> {F3:pos  F3:vel}
// (float)((double)((long long)xs_mod(r >> k, 256) - 128) / 16.0)
speed -> {
  u64:s -> 0
  -> ((((s % 256) - 128) \ f64) / 16.0) \ f32
}
// for (i = 0; i < n; i++) { r = xs_next(r); P p; p.pos.x = (float)xs_mod(r, 1024); ...; ps.push_back(p); }
spawn -> {
  u32:n -> ??
  i64:i -> 0
  u64:r -> 12345
  Array{T <- P}:ps -> {}
  -> i ? {
    >=n -> ps
    -> {
      s -> xs{x -> r}!
      p -> {
        pos -> {x -> (s % 1024) \ f32  y -> ((s >> 12) % 1024) \ f32  z -> ((s >> 24) % 1024) \ f32}
        vel -> {x -> speed{s -> s >> 36}!  y -> speed{s -> s >> 44}!  z -> speed{s -> s >> 52}!}
      }
      -> spawn{n -> n  i -> i + 1  r -> s  ps -> {...ps  p}}!
    }!
  }
}
// p.vel.y += -0.0625f; p.pos.x += p.vel.x; p.pos.y += p.vel.y; p.pos.z += p.vel.z;
// if (p.pos.y < 0.0f) { p.pos.y = -p.pos.y; p.vel.y = -(p.vel.y * 0.5f); }
move -> {
  P:p -> ??
  -> {
    vel -> p.vel{y -> p.vel.y + -0.0625}
    pos -> p.pos{x -> p.pos.x + vel.x  y -> p.pos.y + vel.y  z -> p.pos.z + vel.z}
    -> pos.y ? {
      <0.0 -> {pos -> pos{y -> -pos.y}  vel -> vel{y -> -(vel.y * 0.5)}}
      -> {pos -> pos  vel -> vel}
    }
  }!
}
// for (P &p : ps) the move of p
step -> {
  m <- 0..
  Array{T <- P  n <- m}:ps -> {}
  i64:i -> 0
  -> i ? {
    >=m -> ps
    -> step{ps -> ps{#i -> move{p -> ps.#i}!}  i -> i + 1}!
  }
}
// for (s = 0; s < STEPS; s++) the step
steps -> {
  Array{T <- P}:ps -> {}
  i64:s -> 0
  -> s ? {
    >=STEPS -> ps
    -> steps{ps -> step{ps -> ps}!  s -> s + 1}!
  }
}
// for (const P &p : ps) total += (long long)(p.pos.x * 16.0f) + (long long)(p.pos.y * 16.0f) + (long long)(p.pos.z * 16.0f);
total -> {
  Array{T <- P}:ps -> {}
  i64:total -> 0
  -> ps ? {
    {P(p)  ...Array{T <- P}:(rest)} -> total{
      ps -> rest
      total -> total + ((p.pos.x * 16.0) \ i64) + ((p.pos.y * 16.0) \ i64) + ((p.pos.z * 16.0) \ i64)
    }!
    -> total
  }
}
-> {
  u32:n -> ??
  ps -> steps{ps -> spawn{n -> n}!}!
  a -> io.printf{format -> "%lld\n"  n -> n}!
  -> io.printf{format -> "%lld\n"  n -> total{ps -> ps}!}!
}!
