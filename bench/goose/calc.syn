// calc: Goose bench/cpp/calc.cpp (the C++ the harness compares Goose with, VARIANT
// 0: unique_ptr trees, errors thrown), in plain Syntact. N arithmetic expressions of
// depth 3..6 generated as text, one in four damaged -- a paren dropped, a stray
// character, a truncated text, a division by zero --, each parsed by recursive
// descent into its own tree and evaluated in u64. A thrown error is a result that
// each caller passes up. Prints the characters read, the nodes built (bad inputs
// included), the inputs that evaluate, the count of each error and the checksum.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
  printu -> <printf>{string:format, u64:n, -> !?::i32}
}
// an array that captures its length in a hole
Array -> {
  T <- {}
  n <- 0..
  -> {...({T:} * n):}
}
// v.size(): the length the array captures
len -> {
  T <- {}
  n <- 0..
  Array{T <- T  n <- n}:xs -> {}
  -> n
}
// std::string
String -> Array{T <- u8}
// xorshift64, as bench/cpp/bench.h: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
M -> 0xffffffffffffffff
E_EOF -> 1
E_PAREN -> 2
E_TOKEN -> 3
E_DIV0 -> 4
Error -> 1..4

// --- the text --------------------------------------------------------------------

// if (v >= 10) text.push_back('0' + v / 10); text.push_back('0' + v % 10);
emit_num -> {
  String:text -> {}
  i64:v -> 0
  -> {
    t1 -> v ? {
      >=10 -> {...text  48 + v / 10}
      -> text
    }
    -> {...t1  48 + v % 10}
  }!
}
// r = xs_next(seed); k = xs_mod(r, 8);
// if (depth == 0 || k == 0) { emit_num(1 + xs_mod(r >> 8, 99)); return r; }
// if (k == 1) { text.push_back('-'); return gen(depth - 1, r); }
// if (k == 2) { text.push_back('('); r = gen(depth - 1, r); text.push_back(')'); return r; }
// r = gen(depth - 1, r); op = xs_mod(r >> 16, 4); text += " op "; return gen(depth - 1, xs_next(r));
gen -> {
  (0..6):depth -> 0
  u64:seed -> 0
  String:text -> {}
  -> {
    r -> xs{x -> seed}!
    k -> r % 8
    -> ((depth = 0) [|] (k = 0)) ? {
      true -> {r -> r  text -> emit_num{text -> text  v -> 1 + (r >> 8) % 99}!}
      -> k ? {
        1 -> gen{depth -> depth - 1  seed -> r  text -> {...text  45}}!
        2 -> {
          g -> gen{depth -> depth - 1  seed -> r  text -> {...text  40}}!
          -> {r -> g.r  text -> {...g.text  41}}
        }!
        -> {
          g -> gen{depth -> depth - 1  seed -> r  text -> text}!
          op -> (g.r >> 16) % 4
          c -> op ? {0 -> 43  1 -> 45  2 -> 42  -> 47}
          -> gen{depth -> depth - 1  seed -> xs{x -> g.r}!  text -> {...g.text  32  c  32}}!
        }!
      }
    }
  }!
}
// text.resize(text.size() / 2): the bytes of text up to e
prefix -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> ??
  u64:k -> 0
  (0..tl):e -> 0
  String:w -> {}
  -> k ? {
    >=e -> w
    -> prefix{text -> text  k -> k + 1  e -> e  w -> {...w  text.#k}}!
  }
}
// kind = xs_mod(seed, 16);
// 0: the last ')' becomes ' ', or text[0] = '#' when there is none; 1: text[xs_mod(seed >> 8, size)] = '#';
// 2: text.resize(size / 2); 3: text += " / 0";
corrupt -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> ??
  u64:seed -> 0
  -> {
    // while (i > 0) { i--; if (text[i] == ')') { text[i] = ' '; return; } } text[0] = '#';
    last_paren -> {
      (0..tl):i -> 0
      -> i ? {
        >0 -> text.#(i - 1) ? {
          41 -> text{#(i - 1) -> 32}
          -> last_paren{i -> i - 1}!
        }
        -> text{#0 -> 35}
      }
    }
    -> (seed % 16) ? {
      0 -> last_paren{i -> tl}!
      1 -> {
        at -> (seed >> 8) % tl
        -> text{#at -> 35}
      }!
      2 -> prefix{text -> text  e -> tl / 2}!
      // " / 0"
      3 -> {...text  32  47  32  48}
      -> text
    }
  }!
}

// --- the parse -------------------------------------------------------------------

// Num { v }, Neg { l }, Paren { l }, Bin { op, l, r }
Expr -> {
  -> {i64:v}
  -> {Expr:neg}
  -> {Expr:paren}
  -> {u8:op  Expr:l  Expr:r}
}
// an expression parsed and the position after it, or the error thrown; with the nodes built
Parsed -> {
  -> {Expr:node  u64:pos  i64:nodes}
  -> {Error:err  i64:nodes}
}
// while (pos < text.size() && text[pos] == ' ') pos++;
skip -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> ??
  u64:pos -> 0
  -> pos ? {
    >=tl -> pos
    -> text.#pos ? {
      32 -> skip{text -> text  pos -> pos + 1}!
      -> pos
    }
  }
}
// while (pos < text.size() && text[pos] >= '0' && text[pos] <= '9') { v = v * 10 + (text[pos] - '0'); pos++; }
number -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> ??
  u64:pos -> 0
  i64:v -> 0
  -> pos ? {
    >=tl -> {pos -> pos  v -> v}
    -> {
      d -> text.#pos
      -> ((d >= 48) [&] (d <= 57)) ? {
        true -> number{text -> text  pos -> pos + 1  v -> v * 10 + (d - 48)}!
        -> {pos -> pos  v -> v}
      }
    }!
  }
}
// parse_expr, parse_term and parse_factor call each other: a name is read only above
// its use, so the two others are written inside parse_expr, over its text
parse_expr -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> ??
  u64:pos -> 0
  i64:nodes -> 0
  -> {
  // skip(); if (pos >= size) throw E_EOF; a number, or '-' factor, or '(' expr ')', else throw E_TOKEN
  parse_factor -> {
    u64:pos -> 0
    i64:nodes -> 0
    -> {
      p -> skip{text -> text  pos -> pos}!
      -> p ? {
        >=tl -> {err -> E_EOF  nodes -> nodes}
        -> {
          c -> text.#p
          -> ((c >= 48) [&] (c <= 57)) ? {
            true -> {
              num -> number{text -> text  pos -> p}!
              -> {node -> {v -> num.v}  pos -> num.pos  nodes -> nodes + 1}
            }!
            -> c ? {
              45 -> {
                f -> parse_factor{pos -> p + 1  nodes -> nodes}!
                -> f ? {
                  {Expr:node  u64:pos  i64:nodes} -> {node -> {neg -> node}  pos -> pos  nodes -> nodes + 1}
                  -> f
                }
              }!
              40 -> {
                x -> parse_expr{text -> text  pos -> p + 1  nodes -> nodes}!
                -> x ? {
                  {Expr:node  u64:pos  i64:nodes} -> {
                    q -> skip{text -> text  pos -> pos}!
                    -> q ? {
                      >=tl -> {err -> E_PAREN  nodes -> nodes}
                      -> text.#q ? {
                        41 -> {node -> {paren -> node}  pos -> q + 1  nodes -> nodes + 1}
                        -> {err -> E_PAREN  nodes -> nodes}
                      }
                    }
                  }!
                  -> x
                }
              }!
              -> {err -> E_TOKEN  nodes -> nodes}
            }
          }
        }!
      }
    }!
  }
  // for (;;) { skip(); if (pos >= size || (text[pos] != '*' && text[pos] != '/')) break;
  //   op = text[pos]; pos++; rhs = parse_factor(); nodes++; lhs = Bin(op, lhs, rhs); }
  terms -> {
    Expr:lhs -> {v -> 0}
    u64:pos -> 0
    i64:nodes -> 0
    -> {
      p -> skip{text -> text  pos -> pos}!
      stop -> {node -> lhs  pos -> p  nodes -> nodes}
      -> p ? {
        >=tl -> stop
        -> {
          c -> text.#p
          -> ((c = 42) [|] (c = 47)) ? {
            true -> {
              f -> parse_factor{pos -> p + 1  nodes -> nodes}!
              -> f ? {
                {Expr:node  u64:pos  i64:nodes} -> terms{lhs -> {op -> c  l -> lhs  r -> node}  pos -> pos  nodes -> nodes + 1}!
                -> f
              }
            }!
            -> stop
          }
        }!
      }
    }!
  }
  parse_term -> {
    u64:pos -> 0
    i64:nodes -> 0
    -> {
      f -> parse_factor{pos -> pos  nodes -> nodes}!
      -> f ? {
        {Expr:node  u64:pos  i64:nodes} -> terms{lhs -> node  pos -> pos  nodes -> nodes}!
        -> f
      }
    }!
  }
  // for (;;) { skip(); if (pos >= size || (text[pos] != '+' && text[pos] != '-')) break;
  //   op = text[pos]; pos++; rhs = parse_term(); nodes++; lhs = Bin(op, lhs, rhs); }
  sums -> {
    Expr:lhs -> {v -> 0}
    u64:pos -> 0
    i64:nodes -> 0
    -> {
      p -> skip{text -> text  pos -> pos}!
      stop -> {node -> lhs  pos -> p  nodes -> nodes}
      -> p ? {
        >=tl -> stop
        -> {
          c -> text.#p
          -> ((c = 43) [|] (c = 45)) ? {
            true -> {
              t -> parse_term{pos -> p + 1  nodes -> nodes}!
              -> t ? {
                {Expr:node  u64:pos  i64:nodes} -> sums{lhs -> {op -> c  l -> lhs  r -> node}  pos -> pos  nodes -> nodes + 1}!
                -> t
              }
            }!
            -> stop
          }
        }!
      }
    }!
  }
  t -> parse_term{pos -> pos  nodes -> nodes}!
  -> t ? {
    {Expr:node  u64:pos  i64:nodes} -> sums{lhs -> node  pos -> pos  nodes -> nodes}!
    -> t
  }
  }!
}

// --- the evaluation --------------------------------------------------------------

// a value, or the error thrown
Value -> {
  -> {u64:value}
  -> {Error:err}
}
// Num: (uint64_t)v; Neg: 0 - eval(l); Paren: eval(l);
// Bin: a = eval(l); b = eval(r); + - * wrap; '/': if (b == 0) throw E_DIV0; a / b
eval -> {
  Expr:e -> {v -> 0}
  -> e ? {
    {i64:v} -> {value -> v \ u64}
    {Expr:neg} -> {
      a -> eval{e -> neg}!
      -> a ? {
        {u64:value} -> {value -> (0 - value) [&] M}
        -> a
      }
    }!
    {Expr:paren} -> eval{e -> paren}!
    {u8:op  Expr:l  Expr:r} -> {
      a -> eval{e -> l}!
      -> a ? {
        {u64:value} -> {
          x -> value
          b -> eval{e -> r}!
          -> b ? {
            {u64:value} -> op ? {
              43 -> {value -> (x + value) [&] M}
              45 -> {value -> (x - value) [&] M}
              42 -> {value -> (x * value) [&] M}
              -> value ? {
                0 -> {err -> E_DIV0}
                -> {value -> x / value}
              }
            }
            -> b
          }
        }!
        -> a
      }
    }!
  }
}
// pos = 0; root = parse_expr(); skip(); if (pos != text.size()) return E_TOKEN; out = eval(root); return 0;
// (the error, 0 when the input evaluates; its value; the nodes)
run_one -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> ??
  i64:nodes -> 0
  -> {
    x -> parse_expr{text -> text  pos -> 0  nodes -> nodes}!
    -> x ? {
      {Expr:node  u64:pos  i64:nodes} -> {
        q -> skip{text -> text  pos -> pos}!
        -> (q = tl) ? {
          true -> {
            v -> eval{e -> node}!
            -> v ? {
              {u64:value} -> {err -> 0  value -> value  nodes -> nodes}
              {Error:err} -> {err -> err  value -> 0  nodes -> nodes}
            }
          }!
          -> {err -> E_TOKEN  value -> 0  nodes -> nodes}
        }
      }!
      {Error:err  i64:nodes} -> {err -> err  value -> 0  nodes -> nodes}
    }
  }!
}
// for (i = 0; i < BENCH_N; i++) { seed = xs_next(seed); text.clear(); depth = 3 + xs_mod(seed, 4);
//   s = gen(depth, seed >> 8); corrupt(s); chars += text.size(); err = run_one(v);
//   if (err == 0) { ok++; sum = sum * 31 + v; } else errs[err] += 1; }
inputs -> {
  u32:n -> ??
  i64:i -> 0
  u64:seed -> 12345
  i64:ok -> 0
  i64:chars -> 0
  Array{T <- i64  n <- 5}:errs -> {0  0  0  0  0}
  u64:sum -> 0
  i64:nodes -> 0
  -> i ? {
    >=n -> {ok -> ok  chars -> chars  errs -> errs  sum -> sum  nodes -> nodes}
    -> {
      s -> xs{x -> seed}!
      g -> gen{depth -> 3 + s % 4  seed -> s >> 8  text -> {}}!
      String:text -> corrupt{text -> g.text  seed -> g.r}!
      run -> run_one{text -> text  nodes -> nodes}!
      e -> run.err
      -> e ? {
        0 -> inputs{n -> n  i -> i + 1  seed -> s  ok -> ok + 1  chars -> chars + len{xs -> text}!  errs -> errs  sum -> (sum * 31 + run.value) [&] M  nodes -> run.nodes}!
        -> inputs{n -> n  i -> i + 1  seed -> s  ok -> ok  chars -> chars + len{xs -> text}!  errs -> errs{#e -> errs.#e + 1}  sum -> sum  nodes -> run.nodes}!
      }
    }!
  }
}
-> {
  u32:n -> ??
  t -> inputs{n -> n}!
  a -> io.printf{format -> "%lld\n"  n -> t.chars}!
  b -> io.printf{format -> "%lld\n"  n -> t.nodes}!
  c -> io.printf{format -> "%lld\n"  n -> t.ok}!
  d -> io.printf{format -> "%lld\n"  n -> t.errs.#E_EOF}!
  e -> io.printf{format -> "%lld\n"  n -> t.errs.#E_PAREN}!
  f -> io.printf{format -> "%lld\n"  n -> t.errs.#E_TOKEN}!
  g -> io.printf{format -> "%lld\n"  n -> t.errs.#E_DIV0}!
  -> io.printu{format -> "%llu\n"  n -> t.sum}!
}!
