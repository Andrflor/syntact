// calc (Goose bench/goose/calc.goose): N arithmetic expressions of depth 3..6 are
// generated as text, one in four damaged -- a paren dropped, a stray character, a
// truncated text, a division by zero --, each parsed by recursive descent into its
// own tree and evaluated in u64. An error stops its input from deep inside the
// recursion and is counted by kind. Prints the characters read, the nodes built
// (bad inputs included), the inputs that evaluate, the count of each error and the
// checksum of the values.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
// the checksum is a u64 and printed as one
iou -> <libc.so.6>{
  printf -> {string:format, u64:n, -> !?::i32}
}
Array -> {
  T -> {}
  -> {}
  -> {T: ...Array{T}:}
}
A -> Array{u8}
// xorshift64, as bench/goose/rng.goose: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
M -> 0xffffffffffffffff
E_EOF -> 1
E_PAREN -> 2
E_TOKEN -> 3
E_DIV0 -> 4
Error -> 1..4

// --- generation --------------------------------------------------------------
// The text is carried through the generator, which gives it back extended with
// the state of the chain. Bytes are written by their codes: there is no operator
// from a character to an integer (specs/language/02).

// v in 1..99, after text
emit_num -> {
  A:text -> {}
  (1..99):v -> 1
  -> v ? {
    >=10 -> {...text  48 + v / 10  48 + v % 10}
    -> {...text  48 + v}
  }
}
// the byte of an operator: + - * /
opchar -> {
  (0..3):op
  -> op ? {0 -> 43  1 -> 45  2 -> 42  -> 47}
}
Gen -> {A:text  u64:r}
// an expression of at most the given depth after text, with the state of the
// chain after it
gen -> {
  A:text -> {}
  (0..6):depth -> 0
  u64:seed -> 0
  -> {
    r -> xs{x -> seed}!
    k -> r % 8
    num -> Gen{emit_num{text -> text  v -> 1 + (r >> 8) % 99}!  r}
    -> depth ? {
      0 -> num
      -> k ? {
        0 -> num
        1 -> gen{text -> {...text  45}  depth -> depth - 1  seed -> r}!
        2 -> {
          g -> gen{text -> {...text  40}  depth -> depth - 1  seed -> r}!
          -> Gen{{...g.text  41}  g.r}
        }!
        -> {
          l -> gen{text -> text  depth -> depth - 1  seed -> r}!
          op -> opchar{op -> (l.r >> 16) % 4}!
          -> gen{text -> {...l.text  32 op 32}  depth -> depth - 1  seed -> xs{x -> l.r}!}!
        }!
      }
    }
  }!
}

size -> {
  A:s -> {}
  -> s ? {
    {u8(b)  ...A:(t)} -> 1 + size{s -> t}!
    -> 0
  }
}
// t with its last ')' made a space, and whether there was one
Unparen -> {bool:found  A:text}
unparen -> {
  A:t -> {}
  -> t ? {
    {u8(c)  ...A:(rest)} -> {
      u -> unparen{t -> rest}!
      -> u.found ? {
        true -> Unparen{true  {c  ...u.text}}
        -> c ? {
          41 -> Unparen{true  {32  ...rest}}
          -> Unparen{false  t}
        }
      }
    }!
    -> Unparen{false  {}}
  }
}
// t with its byte at place k made b
set -> {
  A:t -> {}
  u64:k -> 0
  u8:b -> 0
  -> t ? {
    {u8(c)  ...A:(rest)} -> k ? {
      0 -> {b  ...rest}
      -> {c  ...set{t -> rest  k -> k - 1  b -> b}!}
    }
    -> {}
  }
}
// the first n bytes of t
prefix -> {
  A:t -> {}
  u64:n -> 0
  -> n ? {
    0 -> {}
    -> t ? {
      {u8(c)  ...A:(rest)} -> {c  ...prefix{t -> rest  n -> n - 1}!}
      -> {}
    }
  }
}
// one in four inputs is damaged after generation
corrupt -> {
  A:text -> {}
  u64:seed -> 0
  -> seed % 16 ? {
    0 -> {
      u -> unparen{t -> text}!
      -> u.found ? {
        true -> u.text
        -> set{t -> text  k -> 0  b -> 35}!
      }
    }!
    1 -> set{t -> text  k -> (seed >> 8) % size{s -> text}!  b -> 35}!
    2 -> prefix{t -> text  n -> size{s -> text}! / 2}!
    // " / 0"
    3 -> {...text  32 47 32 48}
    -> text
  }
}

// --- the tree ----------------------------------------------------------------

Expr -> {
  -> {u64:v}
  -> {Expr:neg}
  -> {Expr:paren}
  -> {u8:op  Expr:l  Expr:r}
}

// --- parsing -----------------------------------------------------------------
// The cursor is the text from it on. Every node built is counted, on the inputs
// that fail too.

skip -> {
  A:t -> {}
  -> t ? {
    {32  ...A:(rest)} -> skip{t -> rest}!
    -> t
  }
}
// a number read from the front of t, after the digits v read so far
Number -> {u64:v  A:rest}
number -> {
  A:t -> {}
  u64:v -> 0
  -> t ? {
    {(48..57):(c)  ...A:(rest)} -> number{t -> rest  v -> (v * 10 + (c - 48)) [&] M}!
    -> Number{v -> v  rest -> t}
  }
}
// an expression read from t, or the error that stops the input, with the nodes
// built so far
Parsed -> {
  -> {Expr:e  A:rest  i64:nodes}
  -> {Error:err  i64:nodes}
}
// the operator of a level at the front of t, or 0: + - for expressions (0),
// * / for terms (1)
binop -> {
  (0..1):level
  A:t -> {}
  -> t ? {
    {u8(c)  ...A:} -> level ? {
      0 -> c ? {43 -> 43  45 -> 45  -> 0}
      -> c ? {42 -> 42  47 -> 47  -> 0}
    }
    -> 0
  }
}
// The recursive descent: level 0 is parse_expr, 1 parse_term, 2 parse_factor.
// With more, the loop of an expression or a term goes on after lhs.
parse -> {
  A:t -> {}
  (0..2):level -> 0
  i64:nodes -> 0
  bool:more -> false
  Expr:lhs -> {v -> 0}
  -> level ? {
    2 -> skip{t -> t}! ? {
      {(48..57):  ...A:} -> {
        num -> number{t -> skip{t -> t}!}!
        -> {e -> {v -> num.v}  rest -> num.rest  nodes -> nodes + 1}
      }!
      {45  ...A:(rest)} -> {
        Parsed:f -> parse{t -> rest  level -> 2  nodes -> nodes}!
        -> f ? {
          {Expr:e  A:rest  i64:nodes} -> {e -> {neg -> e}  rest -> rest  nodes -> nodes + 1}
          -> f
        }
      }!
      {40  ...A:(rest)} -> {
        Parsed:x -> parse{t -> rest  level -> 0  nodes -> nodes}!
        -> x ? {
          {Expr:e  A:rest  i64:nodes} -> skip{t -> rest}! ? {
            {41  ...A:(after)} -> {e -> {paren -> e}  rest -> after  nodes -> nodes + 1}
            -> {err -> E_PAREN  nodes -> nodes}
          }
          -> x
        }
      }!
      {u8:  ...A:} -> {err -> E_TOKEN  nodes -> nodes}
      -> {err -> E_EOF  nodes -> nodes}
    }
    -> more ? {
      true -> {
        s -> skip{t -> t}!
        op -> binop{level -> level  t -> s}!
        -> op ? {
          0 -> {e -> lhs  rest -> s  nodes -> nodes}
          -> s ? {
            {u8:  ...A:(rest)} -> {
              Parsed:y -> parse{t -> rest  level -> level + 1  nodes -> nodes}!
              -> y ? {
                {Expr:e  A:rest  i64:nodes} -> parse{
                  t -> rest  level -> level  nodes -> nodes + 1  more -> true
                  lhs -> {op -> op  l -> lhs  r -> e}
                }!
                -> y
              }
            }!
            -> {e -> lhs  rest -> s  nodes -> nodes}
          }
        }
      }!
      -> {
        Parsed:x -> parse{t -> t  level -> level + 1  nodes -> nodes}!
        -> x ? {
          {Expr:e  A:rest  i64:nodes} -> parse{t -> rest  level -> level  nodes -> nodes  more -> true  lhs -> e}!
          -> x
        }
      }!
    }
  }
}

// --- evaluation --------------------------------------------------------------
// Unsigned: u64 wraps, written as a mask.

Value -> {
  -> {u64:val}
  -> {Error:err}
}
eval -> {
  Expr:e -> {v -> 0}
  -> e ? {
    {u64:v} -> {val -> v}
    {Expr:neg} -> {
      Value:a -> eval{e -> neg}!
      -> a ? {
        {u64:val} -> {val -> (0 - val) [&] M}
        -> a
      }
    }!
    {Expr:paren} -> eval{e -> paren}!
    {u8:op  Expr:l  Expr:r} -> {
      Value:a -> eval{e -> l}!
      -> a ? {
        {u64:val} -> {
          x -> val
          Value:b -> eval{e -> r}!
          -> b ? {
            {u64:val} -> op ? {
              43 -> {val -> (x + val) [&] M}
              45 -> {val -> (x - val) [&] M}
              42 -> {val -> (x * val) [&] M}
              -> val ? {
                0 -> {err -> E_DIV0}
                -> {val -> x / val}
              }
            }
            -> b
          }
        }!
        -> a
      }
    }!
  }
}

// one input: its own tree, gone when it is done however the input ends
Run -> {
  -> {u64:val  i64:nodes}
  -> {Error:err  i64:nodes}
}
run_one -> {
  A:text -> {}
  -> {
    Parsed:p -> parse{t -> text}!
    -> p ? {
      {Expr:e  A:rest  i64:nodes} -> skip{t -> rest}! ? {
        {} -> {
          Value:v -> eval{e -> e}!
          -> v ? {
            {u64:val} -> {val -> val  nodes -> nodes}
            {Error:err} -> {err -> err  nodes -> nodes}
          }
        }!
        -> {err -> E_TOKEN  nodes -> nodes}
      }
      {Error:err  i64:nodes} -> {err -> err  nodes -> nodes}
    }
  }!
}

Stats -> {i64:chars  i64:nodes  i64:ok  i64:eof  i64:paren  i64:token  i64:div0  u64:sum}
inputs -> {
  u32:n -> ??
  u64:seed -> 12345
  Stats:s -> Stats{0  0  0  0  0  0  0  0}
  -> n ? {
    0 -> s
    -> {
      sd -> xs{x -> seed}!
      g -> gen{depth -> 3 + sd % 4  seed -> sd >> 8}!
      text -> corrupt{text -> g.text  seed -> g.r}!
      Run:o -> run_one{text -> text}!
      chars -> s.chars + size{s -> text}!
      -> inputs{
        n -> n - 1
        seed -> sd
        s -> o ? {
          {u64:val  i64:nodes} -> Stats{chars  nodes + s.nodes  s.ok + 1  s.eof  s.paren  s.token  s.div0  (s.sum * 31 + val) [&] M}
          {Error:err  i64:nodes} -> err ? {
            1 -> Stats{chars  nodes + s.nodes  s.ok  s.eof + 1  s.paren  s.token  s.div0  s.sum}
            2 -> Stats{chars  nodes + s.nodes  s.ok  s.eof  s.paren + 1  s.token  s.div0  s.sum}
            3 -> Stats{chars  nodes + s.nodes  s.ok  s.eof  s.paren  s.token + 1  s.div0  s.sum}
            -> Stats{chars  nodes + s.nodes  s.ok  s.eof  s.paren  s.token  s.div0 + 1  s.sum}
          }
        }
      }!
    }!
  }
}
-> {
  u32:n -> ??
  s -> inputs{n -> n}!
  a -> io.printf{format -> "%lld\n"  n -> s.chars}!
  b -> io.printf{format -> "%lld\n"  n -> s.nodes}!
  c -> io.printf{format -> "%lld\n"  n -> s.ok}!
  d -> io.printf{format -> "%lld\n"  n -> s.eof}!
  e -> io.printf{format -> "%lld\n"  n -> s.paren}!
  f -> io.printf{format -> "%lld\n"  n -> s.token}!
  g -> io.printf{format -> "%lld\n"  n -> s.div0}!
  -> iou.printf{format -> "%llu\n"  n -> s.sum}!
}!
