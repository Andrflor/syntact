// blur (Goose bench/goose/blur.goose): a WxW u8 image from xorshift64, 16 passes of
// a 3x3 [1 2 1] blur (s >> 4) between two buffers, borders kept; sum of the image.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
Array -> {
  T -> {}
  -> {}
  -> {T: ...Array{T}:}
}
// xorshift64, as bench/goose/rng.goose: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
image -> {
  u32:n -> ??
  u64:r -> 12345
  -> n ? {0 -> {}  -> {(xs{x -> r}! % 256) ...image{n -> n - 1  r -> xs{x -> r}!}!}}
}
// one pass: dst at i = the stencil of src around i, for the inner pixels; the
// border pixels of dst are those of the previous dst (zeros at the first pass)
pass -> {
  u32:w -> 3
  Array{u8}:src -> {}
  Array{u8}:dst -> {}
  u32:i -> 0
  -> i ? {
    =(w * w) -> {}
    -> {
      y -> i / w
      x -> i % w
      inner -> (y > 0) [&] (y < w - 1) [&] (x > 0) [&] (x < w - 1)
      v -> inner ? {
        true -> (src.#(i - w - 1) + src.#(i - w) * 2 + src.#(i - w + 1) + src.#(i - 1) * 2 + src.#i * 4 + src.#(i + 1) * 2 + src.#(i + w - 1) + src.#(i + w) * 2 + src.#(i + w + 1)) >> 4
        -> dst.#i
      }
      -> {v ...pass{w -> w  src -> src  dst -> dst  i -> i + 1}!}
    }!
  }
}
passes -> {
  u32:w -> 3
  Array{u8}:a -> {}
  Array{u8}:b -> {}
  u8:p -> 0
  -> p ? {
    <8 -> {
      b2 -> pass{w -> w  src -> a  dst -> b}!
      -> passes{w -> w  a -> pass{w -> w  src -> b2  dst -> a}!  b -> b2  p -> p + 1}!
    }!
    -> a
  }
}
total -> {
  Array{u8}:xs -> {}
  i64:acc -> 0
  -> xs ? {
    {u8(h) ...Array{u8}:(t)} -> total{xs -> t  acc -> acc + h}!
    -> acc
  }
}
zeros -> {
  u32:n -> ??
  -> n ? {0 -> {}  -> {0 ...zeros{n -> n - 1}!}}
}
-> {
  (3..65535):w -> ??
  a -> image{n -> w * w}!
  b -> zeros{n -> w * w}!
  c -> io.printf{format -> "%lld\n"  n -> w}!
  -> io.printf{format -> "%lld\n"  n -> total{xs -> passes{w -> w  a -> a  b -> b}!}!}!
}!
