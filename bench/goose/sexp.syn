// sexp: Goose bench/cpp/sexp.cpp (the C++ the harness compares Goose with), in
// plain Syntact. N random s-expressions of depth up to 4 written into one text
// (symbols of 3..14 letters, numbers below 100000, lists of 2..5 items), then
// parsed back into nodes, each list's items chained in reverse through next; four
// passes walk the roots. Prints the text's size, the node count, the root count, 0
// and the total.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
// an array that captures its length in a hole
Array -> {
  T <- {}
  n <- 0..
  -> {...({T:} * n):}
}
// v.size(): the length the array captures
len -> {
  T <- {}
  n <- 0..
  Array{T <- T  n <- n}:xs -> {}
  -> n
}
// std::string
String -> Array{T <- u8}
// xorshift64, as bench/cpp/bench.h: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
DEPTH -> 4
PASSES -> 4

// --- the text --------------------------------------------------------------------

// r = seed; n = 3 + xs_mod(r, 12); for (i = 0; i < n; i++) { r = xs_next(r); text.push_back('a' + xs_mod(r, 26)); }
emit_sym -> {
  String:text -> {}
  u64:seed -> 0
  -> {
    letters -> {
      String:text -> {}
      u64:r -> 0
      i64:n -> 0
      i64:i -> 0
      -> i ? {
        >=n -> text
        -> {
          r1 -> xs{x -> r}!
          -> letters{text -> {...text  97 + r1 % 26}  r -> r1  n -> n  i -> i + 1}!
        }!
      }
    }
    -> letters{text -> text  r -> seed  n -> 3 + seed % 12}!
  }!
}
// if (v == 0) { text.push_back('0'); return; }
// while (v > 0) { tmp[k++] = '0' + v % 10; v /= 10; } while (k > 0) text.push_back(tmp[--k]);
emit_num -> {
  String:text -> {}
  i64:v -> 0
  -> v ? {
    0 -> {...text  48}
    -> {
      down -> {
        i64:v -> 0
        String:tmp -> {}
        -> v ? {
          >0 -> down{v -> v / 10  tmp -> {...tmp  48 + v % 10}}!
          -> tmp
        }
      }
      up -> {
        m <- 0..
        Array{T <- u8  n <- m}:tmp -> {}
        (0..m):k -> 0
        String:text -> {}
        -> k ? {
          >0 -> up{tmp -> tmp  k -> k - 1  text -> {...text  tmp.#(k - 1)}}!
          -> text
        }
      }
      tmp -> down{v -> v}!
      -> up{tmp -> tmp  k -> len{xs -> tmp}!  text -> text}!
    }!
  }
}
// r = xs_next(seed);
// if (depth == 0 || xs_mod(r, 4) == 0) { a symbol or a number; text.push_back(' '); return r; }
// text.push_back('('); kids = 2 + xs_mod(r >> 24, 4); for (k = 0; k < kids; k++) r = gen(depth - 1, r);
// text.push_back(')'); text.push_back(' '); return r;
gen -> {
  (0..4):depth -> 0
  u64:seed -> 0
  String:text -> {}
  -> {
    r -> xs{x -> seed}!
    -> ((depth = 0) [|] (r % 4 = 0)) ? {
      true -> {
        atom -> ((r >> 8) % 2) ? {
          0 -> emit_sym{text -> text  seed -> r}!
          -> emit_num{text -> text  v -> (r >> 16) % 100000}!
        }
        -> {r -> r  text -> {...atom  32}}
      }!
      -> {
        children -> {
          (1..4):depth -> 1
          i64:kids -> 0
          i64:k -> 0
          u64:r -> 0
          String:text -> {}
          -> k ? {
            >=kids -> {r -> r  text -> text}
            -> {
              g -> gen{depth -> depth - 1  seed -> r  text -> text}!
              -> children{depth -> depth  kids -> kids  k -> k + 1  r -> g.r  text -> g.text}!
            }!
          }
        }
        g -> children{depth -> depth  kids -> 2 + (r >> 24) % 4  r -> r  text -> {...text  40}}!
        -> {r -> g.r  text -> {...g.text  41  32}}
      }!
    }
  }!
}
// for (i = 0; i < BENCH_N; i++) seed = gen(DEPTH, seed);
texts -> {
  u32:n -> ??
  i64:i -> 0
  u64:seed -> 12345
  String:text -> {}
  -> i ? {
    >=n -> text
    -> {
      g -> gen{depth -> DEPTH  seed -> seed  text -> text}!
      -> texts{n -> n  i -> i + 1  seed -> g.r  text -> g.text}!
    }!
  }
}

// --- the parse -------------------------------------------------------------------

// struct Node { int kind; std::string name; int32_t v; std::unique_ptr<Node> first, next; }: {} is null
Node -> {
  -> {}
  -> {i32:kind  String:name  i32:v  Node:first  Node:next}
}
// a node, not null
Live -> Node & ~{}
// while (pos < text.size() && text[pos] == ' ') pos++;
skip_space -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> ??
  u64:pos -> 0
  -> pos ? {
    >=tl -> pos
    -> text.#pos ? {
      32 -> skip_space{text -> text  pos -> pos + 1}!
      -> pos
    }
  }
}
// n->name.assign(text, start, pos - start): the bytes of text from start up to e
copy -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> ??
  u64:k -> 0
  (0..tl):e -> 0
  String:w -> {}
  -> k ? {
    >=e -> w
    -> copy{text -> text  k -> k + 1  e -> e  w -> {...w  text.#k}}!
  }
}
parse_node -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> ??
  u64:pos -> 0
  i64:count -> 0
  Node:prev -> {}
  -> {
    p0 -> skip_space{text -> text  pos -> pos}!
    c -> text.#p0
    -> c ? {
      // pos++; for (;;) { skip_space(); if (text[pos] == ')') { pos++; break; } chain = parse_node(chain); }
      40 -> {
        items -> {
          u64:pos -> 0
          i64:count -> 0
          Node:chain -> {}
          -> {
            p1 -> skip_space{text -> text  pos -> pos}!
            -> text.#p1 ? {
              41 -> {pos -> p1 + 1  count -> count  chain -> chain}
              -> {
                q -> parse_node{text -> text  pos -> p1  count -> count  prev -> chain}!
                -> items{pos -> q.pos  count -> q.count  chain -> q.node}!
              }!
            }
          }!
        }
        l -> items{pos -> p0 + 1  count -> count + 1}!
        -> {node -> {kind -> 2  name -> {}  v -> 0  first -> l.chain  next -> prev}  pos -> l.pos  count -> l.count}
      }!
      -> ((c >= 48) [&] (c <= 57)) ? {
        // while (pos < text.size() && text[pos] >= '0' && text[pos] <= '9') { v = v * 10 + (text[pos] - '0'); pos++; }
        true -> {
          number -> {
            u64:pos -> 0
            i64:v -> 0
            -> pos ? {
              >=tl -> {pos -> pos  v -> v}
              -> {
                d -> text.#pos
                -> ((d >= 48) [&] (d <= 57)) ? {
                  true -> number{pos -> pos + 1  v -> v * 10 + (d - 48)}!
                  -> {pos -> pos  v -> v}
                }
              }!
            }
          }
          num -> number{pos -> p0}!
          -> {node -> {kind -> 1  name -> {}  v -> num.v \ i32  first -> {}  next -> prev}  pos -> num.pos  count -> count + 1}
        }!
        // while (pos < text.size() && text[pos] != ' ' && text[pos] != '(' && text[pos] != ')') pos++;
        -> {
          symbol_end -> {
            u64:pos -> 0
            -> pos ? {
              >=tl -> pos
              -> text.#pos ? {
                32 -> pos
                40 -> pos
                41 -> pos
                -> symbol_end{pos -> pos + 1}!
              }
            }
          }
          e -> symbol_end{pos -> p0}!
          -> {node -> {kind -> 0  name -> copy{text -> text  k -> p0  e -> e}!  v -> 0  first -> {}  next -> prev}  pos -> e  count -> count + 1}
        }!
      }
    }
  }!
}
// for (;;) { skip_space(); if (pos >= text.size()) break; roots.push_back(parse_node(nullptr)); }
parse_all -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> ??
  u64:pos -> 0
  i64:count -> 0
  Array{T <- Live}:roots -> {}
  -> {
    p -> skip_space{text -> text  pos -> pos}!
    -> p ? {
      >=tl -> {roots -> roots  count -> count}
      -> {
        q -> parse_node{text -> text  pos -> p  count -> count}!
        -> parse_all{text -> text  pos -> q.pos  count -> q.count  roots -> {...roots  q.node}}!
      }!
    }
  }!
}

// --- the walk --------------------------------------------------------------------

// case 0: name.size() + name[0] + p; case 1: v ^ p; default: 1 + walk_chain(first, p)
// walk_chain(c, p) = c ? walk(c, p) + walk_chain(c->next, p) : 0
walk -> {
  Live:n -> ??
  i64:p -> 0
  -> {
    chain -> {
      Node:c -> {}
      -> c ? {
        {} -> 0
        -> walk{n -> c  p -> p}! + chain{c -> c.next}!
      }
    }
    -> n.kind ? {
      0 -> len{xs -> n.name}! + n.name.#0 + p
      1 -> n.v ^ p
      -> 1 + chain{c -> n.first}!
    }
  }!
}
// for (r : roots) total += walk(r, p)
pass -> {
  Array{T <- Live}:roots -> {}
  i64:p -> 0
  i64:total -> 0
  -> roots ? {
    {Live(r)  ...Array{T <- Live}:(rest)} -> pass{roots -> rest  p -> p  total -> total + walk{n -> r  p -> p}!}!
    -> total
  }
}
// for (p = 0; p < PASSES; p++) the pass, on one total
passes -> {
  Array{T <- Live}:roots -> {}
  i64:p -> 0
  i64:total -> 0
  -> p ? {
    >=PASSES -> total
    -> passes{roots -> roots  p -> p + 1  total -> pass{roots -> roots  p -> p  total -> total}!}!
  }
}
-> {
  u32:n -> ??
  String:text -> texts{n -> n}!
  parsed -> parse_all{text -> text}!
  total -> passes{roots -> parsed.roots}!
  a -> io.printf{format -> "%lld\n"  n -> len{xs -> text}!}!
  b -> io.printf{format -> "%lld\n"  n -> parsed.count}!
  c -> io.printf{format -> "%lld\n"  n -> len{xs -> parsed.roots}!}!
  d -> io.printf{format -> "%lld\n"  n -> 0}!
  -> io.printf{format -> "%lld\n"  n -> total}!
}!
