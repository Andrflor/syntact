// strlist: Goose bench/cpp/strlist.cpp (the C++ the harness compares Goose with), in
// plain Syntact. A text of N words of 3..20 random letters, each followed by a
// space; split at its spaces into a list of words; four scans summing
// w.size() + w[0] + w[w.size() - 1]. Prints the count of words and the total.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
// an array that captures its length in a hole
Array -> {
  T <- {}
  n <- 0..
  -> {...({T:} * n):}
}
// v.size(): the length the array captures
len -> {
  T <- {}
  n <- 0..
  Array{T <- T  n <- n}:xs -> {}
  -> n
}
// std::string
String -> Array{T <- u8}
// a word of the text: the bytes between two spaces, one at least
Word -> Array{T <- u8  n <- 1..}
// xorshift64, as bench/cpp/bench.h: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
// for (j = 0; j < wl; j++) { r = xs_next(r); text.push_back('a' + xs_mod(r, 26)); }
letters -> {
  u64:r -> 0
  i64:wl -> 0
  i64:j -> 0
  String:text -> {}
  -> j ? {
    >=wl -> {r -> r  text -> text}
    -> {
      s -> xs{x -> r}!
      -> letters{r -> s  wl -> wl  j -> j + 1  text -> {...text  97 + s % 26}}!
    }!
  }
}
// for (i = 0; i < N; i++) { r = xs_next(r); wl = 3 + xs_mod(r, 18); the letters; text.push_back(' '); }
make_text -> {
  u32:n -> ??
  i64:i -> 0
  u64:r -> 12345
  String:text -> {}
  -> i ? {
    >=n -> text
    -> {
      s -> xs{x -> r}!
      word -> letters{r -> s  wl -> 3 + s % 18  text -> text}!
      -> make_text{n -> n  i -> i + 1  r -> word.r  text -> {...word.text  32}}!
    }!
  }
}
// while (i < tl && text[i] != ' ') i++;
word_end -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> ??
  u64:i -> 0
  -> i ? {
    >=tl -> i
    -> text.#i ? {
      32 -> i
      -> word_end{text -> text  i -> i + 1}!
    }
  }
}
// while (i < tl && text[i] == ' ') i++;
spaces_end -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> ??
  u64:i -> 0
  -> i ? {
    >=tl -> i
    -> text.#i ? {
      32 -> spaces_end{text -> text  i -> i + 1}!
      -> i
    }
  }
}
// std::string(text.data() + start, i - start): the bytes of text from start up to e
copy -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> ??
  u64:k -> 0
  (0..tl):e -> 0
  String:w -> {}
  -> k ? {
    >=e -> w
    -> copy{text -> text  k -> k + 1  e -> e  w -> {...w  text.#k}}!
  }
}
// for (i = 0; i < tl; ) { start = i; skip the word; words.emplace_back(...); skip the spaces; }
split -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> ??
  u64:i -> 0
  Array{T <- Word}:words -> {}
  -> i ? {
    >=tl -> words
    -> {
      start -> i
      e -> word_end{text -> text  i -> i}!
      -> split{text -> text  i -> spaces_end{text -> text  i -> e}!  words -> {...words  copy{text -> text  k -> start  e -> e}!}}!
    }!
  }
}
// for (w : words) total += w.size() + w[0] + w[w.size() - 1]
scan -> {
  Array{T <- Word}:words -> {}
  i64:total -> 0
  -> words ? {
    {Word(w)  ...Array{T <- Word}:(rest)} -> scan{words -> rest  total -> total + len{xs -> w}! + w.#0 + w.#(len{xs -> w}! - 1)}!
    -> total
  }
}
// for (p = 0; p < 4; p++) the scan, on one total
passes -> {
  Array{T <- Word}:words -> {}
  i64:p -> 0
  i64:total -> 0
  -> p ? {
    >=4 -> total
    -> passes{words -> words  p -> p + 1  total -> scan{words -> words  total -> total}!}!
  }
}
-> {
  String:text -> make_text{n -> ??::u32}!
  Array{T <- Word}:words -> split{text -> text}!
  a -> io.printf{format -> "%lld\n"  n -> len{xs -> words}!}!
  -> io.printf{format -> "%lld\n"  n -> passes{words -> words}!}!
}!
