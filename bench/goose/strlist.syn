// strlist (Goose bench/goose/strlist.goose): one buffer of N words of 3..20 random
// letters, each followed by a space, as bytes; split into a list of words; four
// scans of |w| + w[0] + w[last]. Prints the count of words and the total.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
Array -> {
  T -> {}
  -> {}
  -> {T: ...Array{T}:}
}
A -> Array{u8}
// a word: one letter at least
Word -> {u8: ...A:}
W -> Array{Word}
// xorshift64, as bench/goose/rng.goose: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
// the letters of a word: n of them, each from the next state of the chain
letters -> {
  u64:r -> ??
  (0..20):n -> ??
  -> n ? {
    0 -> {}
    -> {97 + xs{x -> r}! % 26  ...letters{r -> xs{x -> r}!  n -> n - 1}!}
  }
}
// the state of the chain after n letters
after -> {
  u64:r -> ??
  (0..20):n -> ??
  -> n ? {
    0 -> r
    -> after{r -> xs{x -> r}!  n -> n - 1}!
  }
}
// the buffer: n words, each its letters then a space
text -> {
  u32:n -> ??
  u64:r -> 12345
  -> n ? {
    0 -> {}
    -> {
      r1 -> xs{x -> r}!
      wl -> 3 + r1 % 18
      -> {...letters{r -> r1  n -> wl}!  32  ...text{n -> n - 1  r -> after{r -> r1  n -> wl}!}!}
    }!
  }
}
// split: the words of a buffer, cut at its spaces; w the letters read so far
split -> {
  Array{u8}:t -> {}
  Array{u8}:w -> {}
  -> t ? {
    {32  ...Array{u8}:(rest)} -> w ? {
      {} -> split{t -> rest  w -> {}}!
      -> {w  ...split{t -> rest  w -> {}}!}
    }
    {u8(c)  ...Array{u8}:(rest)} -> split{t -> rest  w -> {...w  c}}!
    -> w ? {
      {} -> {}
      -> {w}
    }
  }
}
size -> {
  Array{u8}:t -> {}
  -> t ? {
    {u8(h)  ...Array{u8}:(rest)} -> 1 + size{t -> rest}!
    -> 0
  }
}
count -> {
  W:ws -> {}
  -> ws ? {
    {Word(h)  ...W:(t)} -> 1 + count{ws -> t}!
    -> 0
  }
}
scan -> {
  W:ws -> {}
  acc -> 0
  -> ws ? {
    {Word(w)  ...W:(t)} -> scan{ws -> t  acc -> acc + size{t -> w}! + w.#0 + w.#(size{t -> w}! - 1)}!
    -> acc
  }
}
passes -> {
  (0..4):p -> 4
  W:ws -> {}
  acc -> 0
  -> p ? {
    0 -> acc
    -> passes{p -> p - 1  ws -> ws  acc -> acc + scan{ws -> ws}!}!
  }
}
-> {
  u32:n -> ??
  W:ws -> split{t -> text{n -> n}!}!
  a -> io.printf{format -> "%lld\n"  n -> count{ws -> ws}!}!
  -> io.printf{format -> "%lld\n"  n -> passes{ws -> ws}!}!
}!
