// interp (Goose bench/goose/interp.goose): an expression tree of the given depth —
// Num, Add, Mul, Neg drawn from xorshift64 — then eight evaluations mod 1000003.
// Prints the node count and the total.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
Array -> {
  T -> {}
  -> {}
  -> {T: ...Array{T}:}
}
// xorshift64, as bench/goose/rng.goose: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
// a scope names itself only in its productions (specs/language/08), so the four
// node kinds are written there; Add and Mul differ by their names
Expr -> {
  -> {i32:v}
  -> {Expr:al  Expr:ar}
  -> {Expr:ml  Expr:mr}
  -> {Expr:of}
}
build -> {
  (0..30):depth -> ??
  u64:seed -> 12345
  -> {
    s -> xs{x -> seed}!
    k -> s % 8
    -> depth ? {
      0 -> {v -> s % 1000}
      -> k ? {
        0 -> {of -> build{depth -> depth - 1  seed -> s}!}
        <5 -> {al -> build{depth -> depth - 1  seed -> s}!  ar -> build{depth -> depth - 1  seed -> xs{x -> s}!}!}
        -> {ml -> build{depth -> depth - 1  seed -> s}!  mr -> build{depth -> depth - 1  seed -> xs{x -> s}!}!}
      }
    }
  }!
}
M -> 1000003
eval -> {
  Expr:e -> {v -> 0}
  i64:p -> 0
  -> e ? {
    {i32:v} -> (v + p) % M
    {Expr:al  Expr:ar} -> (eval{e -> al  p -> p}! + eval{e -> ar  p -> p}!) % M
    {Expr:ml  Expr:mr} -> (eval{e -> ml  p -> p}! * eval{e -> mr  p -> p}!) % M
    {Expr:of} -> (M - eval{e -> of  p -> p}!) % M
  }
}
count -> {
  Expr:e -> {v -> 0}
  -> e ? {
    {i32:v} -> 1
    {Expr:al  Expr:ar} -> 1 + count{e -> al}! + count{e -> ar}!
    {Expr:ml  Expr:mr} -> 1 + count{e -> ml}! + count{e -> mr}!
    {Expr:of} -> 1 + count{e -> of}!
  }
}
passes -> {
  Expr:e -> {v -> 0}
  u8:p -> 0
  -> p ? {>=8 -> 0  -> (eval{e -> e  p -> p}! + passes{e -> e  p -> p + 1}!) % M}
}
-> {
  (0..30):depth -> ??
  Expr:root -> build{depth -> depth}!
  a -> io.printf{format -> "%lld\n"  n -> count{e -> root}!}!
  -> io.printf{format -> "%lld\n"  n -> passes{e -> root}!}!
}!
