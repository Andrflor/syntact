// words: Goose bench/cpp/words.cpp (the C++ the harness compares Goose with), in
// plain Syntact. Syntact has no library hash map, so the table is the hand-written
// open-addressed one of the C++ VARIANT 2 (FNV-1a, linear probing); the rest is
// the code every variant shares. A dictionary of n / 10 + 16 random words of 3..14
// letters; a text of n words, word i the entry (a * a) / vocab, a = xs_mod(r, vocab),
// each followed by a space; the text split at its spaces; the words counted.
// Prints the count of words, the distinct ones, and the total of
// count * (key.size() + key[0]) over the table.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
// an array that captures its length in a hole
Array -> {
  T <- {}
  n <- 0..
  -> {...({T:} * n):}
}
// v.size(): the length the array captures
len -> {
  T <- {}
  n <- 0..
  Array{T <- T  n <- n}:xs -> {}
  -> n
}
// std::string
String -> Array{T <- u8}
// a word of the text: the bytes between two spaces, one at least
Word -> Array{T <- u8  n <- 1..}
// xorshift64, as bench/cpp/bench.h: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
// h = 0xcbf29ce484222325; for (c : s) h = (h ^ c) * 0x100000001b3;
fnv -> {
  String:s -> {}
  u64:h -> 0xcbf29ce484222325
  -> s ? {
    {u8(c)  ...String:(rest)} -> fnv{s -> rest  h -> ((h ^ c) * 0x100000001b3) [&] 0xffffffffffffffff}!
    -> h
  }
}
// for (j = 0; j < len; j++) { r = xs_next(r); w.push_back('a' + xs_mod(r, 26)); }
letters -> {
  u64:r -> 0
  i64:n -> 0
  i64:j -> 0
  String:w -> {}
  -> j ? {
    >=n -> {r -> r  w -> w}
    -> {
      s -> xs{x -> r}!
      -> letters{r -> s  n -> n  j -> j + 1  w -> {...w  97 + s % 26}}!
    }!
  }
}
// while (i < tl && text[i] != ' ') i++;
word_end -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> {}
  u64:i -> 0
  -> i ? {
    >=tl -> i
    -> text.#i ? {
      32 -> i
      -> word_end{text -> text  i -> i + 1}!
    }
  }
}
// while (i < tl && text[i] == ' ') i++;
spaces_end -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> {}
  u64:i -> 0
  -> i ? {
    >=tl -> i
    -> text.#i ? {
      32 -> spaces_end{text -> text  i -> i + 1}!
      -> i
    }
  }
}
// the bytes of text from start up to e
copy -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> {}
  u64:k -> 0
  (0..tl):e -> 0
  String:w -> {}
  -> k ? {
    >=e -> w
    -> copy{text -> text  k -> k + 1  e -> e  w -> {...w  text.#k}}!
  }
}
// for (i = 0; i < tl; ) { start = i; skip the word; words.emplace_back(...); skip the spaces; }
split -> {
  tl <- 0..
  Array{T <- u8  n <- tl}:text -> {}
  u64:i -> 0
  Array{T <- Word}:words -> {}
  -> i ? {
    >=tl -> words
    -> {
      start -> i
      e -> word_end{text -> text  i -> i}!
      -> split{text -> text  i -> spaces_end{text -> text  i -> e}!  words -> {...words  copy{text -> text  k -> start  e -> e}!}}!
    }!
  }
}
words -> {
  u32:n -> ??
  vocab -> n / 10 + 16
  Dict -> Array{T <- String  n <- vocab}
  // for (i = 0; i < vocab; i++) { r = xs_next(r); len = 3 + xs_mod(r, 12); the letters; dict.push_back(w); }
  dictionary -> {
    i64:i -> 0
    u64:r -> 12345
    Array{T <- String}:dict -> {}
    -> i ? {
      >=vocab -> {dict -> dict  r -> r}
      -> {
        s -> xs{x -> r}!
        w -> letters{r -> s  n -> 3 + s % 12}!
        -> dictionary{i -> i + 1  r -> w.r  dict -> {...dict  w.w}}!
      }!
    }
  }
  // for (i = 0; i < n; i++) { r = xs_next(r); a = xs_mod(r, vocab); text += dict[(a * a) / vocab]; text.push_back(' '); }
  make_text -> {
    Dict:dict -> ??
    i64:i -> 0
    u64:r -> 0
    String:text -> {}
    -> i ? {
      >=n -> text
      -> {
        s -> xs{x -> r}!
        a -> s % vocab
        -> make_text{dict -> dict  i -> i + 1  r -> s  text -> {...text  ...dict.#((a * a) / vocab)  32}}!
      }!
    }
  }
  // nslots = 16; while (nslots < vocab * 4) nslots *= 2;
  grow -> {
    i64:nslots -> 16
    -> nslots ? {
      >=(vocab * 4) -> nslots
      -> grow{nslots -> nslots * 2}!
    }
  }
  nslots -> grow!
  mask -> nslots - 1
  // struct Slot { std::string_view key; int32_t count = 0; }
  Slot -> {String:key  i32:count}
  Slots -> Array{T <- Slot  n <- nslots}
  // std::vector<Slot> slots(nslots)
  empties -> {
    i64:i -> 0
    Array{T <- Slot}:slots -> {}
    -> i ? {
      >=nslots -> slots
      -> empties{i -> i + 1  slots -> {...slots  {key -> {}  count -> 0}}}!
    }
  }
  // for (;;) { Slot &s = slots[idx]; if (s.count == 0) { s.key = w; s.count = 1; distinct++; break; }
  //   if (s.key == w) { s.count++; break; } idx = (idx + 1) & mask; }
  probe -> {
    Slots:slots -> ??
    Word:w -> ??
    u64:idx -> 0
    i64:distinct -> 0
    -> {
      s -> slots.#idx
      -> s.count ? {
        0 -> {slots -> slots{#idx -> {key -> w  count -> 1}}  distinct -> distinct + 1}
        -> (s.key = w) ? {
          true -> {slots -> slots{#idx -> {key -> s.key  count -> s.count + 1}}  distinct -> distinct}
          -> probe{slots -> slots  w -> w  idx -> (idx + 1) [&] mask  distinct -> distinct}!
        }
      }
    }!
  }
  // for (w : words) { idx = fnv(w) & mask; the probe }
  count -> {
    Array{T <- Word}:words -> {}
    Slots:slots -> ??
    i64:distinct -> 0
    -> words ? {
      {Word(w)  ...Array{T <- Word}:(rest)} -> {
        p -> probe{slots -> slots  w -> w  idx -> fnv{s -> w}! [&] mask  distinct -> distinct}!
        -> count{words -> rest  slots -> p.slots  distinct -> p.distinct}!
      }!
      -> {slots -> slots  distinct -> distinct}
    }
  }
  // for (s : slots) if (s.count > 0) total += s.count * (s.key.size() + s.key[0]);
  weigh -> {
    Array{T <- Slot}:slots -> {}
    i64:total -> 0
    -> slots ? {
      {Slot(s)  ...Array{T <- Slot}:(rest)} -> s.count ? {
        >0 -> weigh{slots -> rest  total -> total + s.count * (len{xs -> s.key}! + s.key.#0)}!
        -> weigh{slots -> rest  total -> total}!
      }
      -> total
    }
  }
  d -> dictionary!
  String:text -> make_text{dict -> d.dict  r -> d.r}!
  Array{T <- Word}:ws -> split{text -> text}!
  table -> count{words -> ws  slots -> empties!}!
  a -> io.printf{format -> "%lld\n"  n -> len{xs -> ws}!}!
  b -> io.printf{format -> "%lld\n"  n -> table.distinct}!
  -> io.printf{format -> "%lld\n"  n -> weigh{slots -> table.slots}!}!
}
-> words{n -> ??::u32}!
