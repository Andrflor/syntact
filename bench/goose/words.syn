// words (Goose bench/goose/words.goose): a dictionary of N/10 + 16 random words of
// 3..14 letters; a text of N words, word i = dict[(a * a) / vocab], a =
// xs_mod(r, vocab); the frequency of each word; prints distinct and the total of
// count * (|w| + w[0]). The dictionary is read at a computed position.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
Array -> {
  T -> {}
  -> {}
  -> {T: ...Array{T}:}
}
// xorshift64, as bench/goose/rng.goose: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
// a letter from 0..25: there is no operator from an integer to a character
// (specs/language/02), so it is a pattern
letter -> {
  (0..25):k
  -> k ? {0 -> "a"  1 -> "b"  2 -> "c"  3 -> "d"  4 -> "e"  5 -> "f"  6 -> "g"  7 -> "h"  8 -> "i"  9 -> "j"  10 -> "k"  11 -> "l"  12 -> "m"  13 -> "n"  14 -> "o"  15 -> "p"  16 -> "q"  17 -> "r"  18 -> "s"  19 -> "t"  20 -> "u"  21 -> "v"  22 -> "w"  23 -> "x"  24 -> "y"  -> "z"}
}
Word -> {string:text  u64:r}
word -> {
  u8:n -> ??
  u64:r -> 12345
  string:acc -> ""
  -> n ? {
    0 -> Word{acc  r}
    -> word{n -> n - 1  r -> xs{x -> r}!  acc -> acc + letter{k -> xs{x -> r}! % 26}!}!
  }
}
Dict -> {Array{string}:words  u64:r}
dict -> {
  u32:n -> ??
  u64:r -> 12345
  Array{string}:acc -> {}
  -> n ? {
    0 -> Dict{acc  r}
    -> {
      s -> xs{x -> r}!
      w -> word{n -> 3 + s % 12  r -> s}!
      -> dict{n -> n - 1  r -> w.r  acc -> {...acc  w.text}}!
    }!
  }
}
text -> {
  Array{string}:d -> {}
  (1..4294967295):vocab -> 1
  u32:n -> ??
  u64:r -> 1
  -> n ? {
    0 -> {}
    -> {
      s -> xs{x -> r}!
      a -> s % vocab
      -> {d.#((a * a) / vocab) ...text{d -> d  vocab -> vocab  n -> n - 1  r -> s}!}
    }!
  }
}
