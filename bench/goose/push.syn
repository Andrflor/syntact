// push: Goose bench/cpp/push.cpp (the C++ the harness compares Goose with), in plain
// Syntact. N items {key, val} pushed, key = xs_mod(r, 1000000), val = i % 97, the
// position of every 64th kept as it is pushed; then the keys summed, and the vals
// read back through the kept positions. Prints nitems, nmarks, total, mt.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
// an array that captures its length in a hole
Array -> {
  T <- {}
  n <- 0..
  -> {...({T:} * n):}
}
// v.size(): the length the array captures
len -> {
  T <- {}
  n <- 0..
  Array{T <- T  n <- n}:xs -> {}
  -> n
}
// xorshift64, as bench/cpp/bench.h: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
Item -> {i32:key  i32:val}
// for (i = 0; i < N; i++) {
//   r = xs_next(r); items.push_back(Item { xs_mod(r, 1000000), i % 97 });
//   if (i % 64 == 0) marks.push_back(items.size() - 1);
// }
build -> {
  u32:n -> ??
  u32:i -> 0
  u64:r -> 12345
  Array{T <- Item}:items -> {}
  Array{T <- u64}:marks -> {}
  -> i ? {
    >=n -> {items -> items  marks -> marks}
    -> {
      s -> xs{x -> r}!
      pushed -> {...items  {key -> s % 1000000  val -> i % 97}}
      kept -> i % 64 ? {
        0 -> {...marks  len{xs -> pushed}! - 1}
        -> marks
      }
      -> build{n -> n  i -> i + 1  r -> s  items -> pushed  marks -> kept}!
    }!
  }
}
// for (it : items) total += it.key
keys -> {
  Array{T <- Item}:items -> {}
  i64:total -> 0
  -> items ? {
    {Item(it)  ...Array{T <- Item}:(rest)} -> keys{items -> rest  total -> total + it.key}!
    -> total
  }
}
// for (m : marks) mt += items[m].val: each mark a place of items
vals -> {
  nitems <- 0..
  Array{T <- Item  n <- nitems}:items -> ??
  Place -> 0..(nitems - 1)
  Array{T <- Place}:marks -> {}
  i64:mt -> 0
  -> marks ? {
    {Place(m)  ...Array{T <- Place}:(rest)} -> vals{items -> items  marks -> rest  mt -> mt + items.#m.val}!
    -> mt
  }
}
-> {
  built -> build{n -> ??::u32}!
  a -> io.printf{format -> "%lld\n"  n -> len{xs -> built.items}!}!
  b -> io.printf{format -> "%lld\n"  n -> len{xs -> built.marks}!}!
  c -> io.printf{format -> "%lld\n"  n -> keys{items -> built.items}!}!
  -> io.printf{format -> "%lld\n"  n -> vals{items -> built.items  marks -> built.marks}!}!
}!
