// records (Goose bench/goose/records_var.goose): a log of N variant records —
// Tick, Move{id dx dy}, Say{id text}, Quit{id code} — drawn from xorshift64, then
// four passes summing their contributions. Prints the length of the log and the total.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
Array -> {
  T -> {}
  -> {}
  -> {T: ...Array{T}:}
}
// xorshift64, as bench/goose/rng.goose: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
Event -> {
  -> {}
  -> {i32:id  i16:dx  i16:dy}
  -> {i32:id  Array{u8}:text}
  -> {i32:id  u8:code}
}
// the letters of a word: n of them, each from the next state of the chain
letters -> {
  u64:r -> ??
  (0..15):n -> ??
  -> n ? {
    0 -> {}
    -> {97 + xs{x -> r}! % 26  ...letters{r -> xs{x -> r}!  n -> n - 1}!}
  }
}
// a word of 4..15 letters from its own chain
word -> {
  u64:seed -> ??
  r -> xs{x -> seed}!
  -> letters{r -> r  n -> 4 + r % 12}!
}
event -> {
  u64:r -> ??
  -> {
    k -> r % 8
    id -> (r >> 3) % 100000
    -> k ? {
      <4 -> {id -> id  dx -> (r >> 20) % 201 - 100  dy -> (r >> 40) % 201 - 100}
      <6 -> {id -> id  text -> word{seed -> r}!}
      <7 -> {id -> id  code -> (r >> 20) % 256}
      -> {}
    }
  }!
}
log -> {
  u32:n -> ??
  u64:r -> 12345
  -> n ? {
    0 -> {}
    -> {event{r -> xs{x -> r}!}!  ...log{n -> n - 1  r -> xs{x -> r}!}!}
  }
}
size -> {
  Array{u8}:t -> {}
  -> t ? {
    {u8:(h)  ...Array{u8}:(rest)} -> 1 + size{t -> rest}!
    -> 0
  }
}
first -> {
  Array{u8}:t -> {}
  -> t ? {
    {u8:(h)  ...Array{u8}:(rest)} -> h
    -> 0
  }
}
contrib -> {
  Event:e -> {}
  -> e ? {
    {i32:id  i16:dx  i16:dy} -> id + dx + dy
    {i32:id  Array{u8}:text} -> id + size{t -> text}! + first{t -> text}!
    {i32:id  u8:code} -> id + code
    -> 1
  }
}
count -> {
  Array{Event}:xs -> {}
  -> xs ? {
    {Event(h)  ...Array{Event}:(t)} -> 1 + count{xs -> t}!
    -> 0
  }
}
total -> {
  Array{Event}:xs -> {}
  acc -> 0
  -> xs ? {
    {Event(h)  ...Array{Event}:(t)} -> total{xs -> t  acc -> acc + contrib{e -> h}!}!
    -> acc
  }
}
passes -> {
  (0..4):p -> 4
  Array{Event}:l -> {}
  acc -> 0
  -> p ? {
    0 -> acc
    -> passes{p -> p - 1  l -> l  acc -> acc + total{xs -> l}!}!
  }
}
-> {
  u32:n -> ??
  Array{Event}:l -> log{n -> n}!
  a -> io.printf{format -> "%lld\n"  n -> count{xs -> l}!}!
  -> io.printf{format -> "%lld\n"  n -> passes{l -> l}!}!
}!
