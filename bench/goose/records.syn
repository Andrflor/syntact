// records: Goose bench/cpp/records.cpp (the C++ the harness compares Goose with), in
// plain Syntact. A log of N variant records -- Tick, Move{id dx dy}, Say{id text},
// Quit{id code} -- drawn from xorshift64, then four passes summing their
// contributions. Prints the length of the log and the total.
io -> <libc.so.6>{
  printf -> {string:format, i64:n, -> !?::i32}
}
// an array that captures its length in a hole
Array -> {
  T <- {}
  n <- 0..
  -> {...({T:} * n):}
}
// v.size(): the length the array captures
len -> {
  T <- {}
  n <- 0..
  Array{T <- T  n <- n}:xs -> {}
  -> n
}
// xorshift64, as bench/cpp/bench.h: u64 wraps, written as a mask
xs -> {
  u64:x
  a -> (x ^ (x << 13)) [&] 0xffffffffffffffff
  b -> a ^ (a >> 7)
  -> (b ^ (b << 17)) [&] 0xffffffffffffffff
}
// Tick, Move, Say, Quit; a Say's text is a word of 4..15 letters, which text[0] reads
Word -> Array{T <- u8  n <- 4..15}
Event -> {
  -> {}
  -> {i32:id  i16:dx  i16:dy}
  -> {i32:id  Word:text}
  -> {i32:id  u8:code}
}
// for (i = 0; i < n; i++) { r = xs_next(r); w.push_back('a' + xs_mod(r, 26)); }
letters -> {
  u64:r -> ??
  u64:n -> 0
  u64:i -> 0
  Array{T <- u8}:w -> {}
  -> i ? {
    >=n -> w
    -> {
      s -> xs{x -> r}!
      -> letters{r -> s  n -> n  i -> i + 1  w -> {...w  97 + s % 26}}!
    }!
  }
}
// r = xs_next(seed); n = 4 + xs_mod(r, 12); then the letters
word -> {
  u64:seed -> ??
  -> {
    r -> xs{x -> seed}!
    -> letters{r -> r  n -> 4 + r % 12}!
  }!
}
// for (i = 0; i < N; i++) { r = xs_next(r); k = r % 8; id = (r >> 3) % 100000; ... }
events -> {
  u32:n -> ??
  u32:i -> 0
  u64:r -> 12345
  Array{T <- Event}:log -> {}
  -> i ? {
    >=n -> log
    -> {
      s -> xs{x -> r}!
      k -> s % 8
      id -> (s >> 3) % 100000
      e -> k ? {
        <4 -> {id -> id  dx -> (s >> 20) % 201 - 100  dy -> (s >> 40) % 201 - 100}
        <6 -> {id -> id  text -> word{seed -> s}!}
        <7 -> {id -> id  code -> (s >> 20) % 256}
        -> {}
      }
      -> events{n -> n  i -> i + 1  r -> s  log -> {...log  e}}!
    }!
  }
}
contrib -> {
  Event:e -> {}
  -> e ? {
    {i32:id  i16:dx  i16:dy} -> id + dx + dy
    {i32:id  Word:text} -> id + len{xs -> text}! + text.#0
    {i32:id  u8:code} -> id + code
    -> 1
  }
}
// for (e : log) total += e->contrib()
pass -> {
  Array{T <- Event}:log -> {}
  i64:total -> 0
  -> log ? {
    {Event(e)  ...Array{T <- Event}:(rest)} -> pass{log -> rest  total -> total + contrib{e -> e}!}!
    -> total
  }
}
// for (p = 0; p < 4; p++) the pass, on one total
passes -> {
  Array{T <- Event}:log -> {}
  i64:p -> 0
  i64:total -> 0
  -> p ? {
    >=4 -> total
    -> passes{log -> log  p -> p + 1  total -> pass{log -> log  total -> total}!}!
  }
}
-> {
  Array{T <- Event}:log -> events{n -> ??::u32}!
  a -> io.printf{format -> "%lld\n"  n -> len{xs -> log}!}!
  -> io.printf{format -> "%lld\n"  n -> passes{log -> log}!}!
}!
